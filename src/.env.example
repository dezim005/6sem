# Copie este arquivo para .env.local, na RAIZ do repositorio Vaga Livre.
# Crie uma branch de desenvolvimento do projeto no Neon antes de iniciar.
# Nunca use credenciais de producao para testes e nunca publique este arquivo.

# String PostgreSQL da branch DE DESENVOLVIMENTO no Neon (pode ser pooled).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-DA-BRANCH-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# URL direta (SEM -pooler) da MESMA branch, usada pela API .NET (migrations EF).
DOTNET_DATABASE_URL="postgresql://USUARIO:SENHA@HOST-DA-BRANCH.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# O arquivo de inicializacao exige confirmacao explicita para reduzir
# risco de rodar migrations e testes no banco principal.
NEON_DEV_BRANCH_CONFIRMED=true

# Segredo so para uso local (substitua por valor aleatorio com 32+ caracteres).
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_LOCAL_ALEATORIO_DE_32_CARACTERES"

# Inclua a API ASP.NET Core. Ela executa migrations EF automaticamente!
START_DOTNET=true

# Opcional. Sem chave Resend, a notificacao persiste, mas envio de email falhara.
# RESEND_API_KEY="re_..."
