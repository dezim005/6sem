datasource db {

provider = "postgresql"

url = env("DATABASE_URL")

}



generator client {

provider = "prisma-client-js"

}



enum Perfil {

ADMIN

SINDICO

MORADOR

}



enum TipoVaga {

COBERTA

DESCOBERTA

}



enum StatusVaga {

LIVRE

OCUPADA

COMPARTILHADA

}



enum StatusCompartilhamento {

ATIVO

FINALIZADO

}



enum StatusReserva {

CONFIRMADA

CANCELADA

FINALIZADA

}



model Usuario {

id String @id @default(uuid())

nome String

email String @unique

senha String

perfil Perfil @default(MORADOR)

apartamento String

bloco String

celular String

createdAt DateTime @default(now())

updatedAt DateTime @updatedAt

veiculos Veiculo[]

vagasFixas Vaga[] @relation("VagaProprietario")

reservas Reserva[]

compartilhamentos Compartilhamento[]



@@map("usuarios")

}



model Veiculo {

id String @id @default(uuid())

marca String

modelo String

cor String

placa String @unique

proprietarioId String

proprietario Usuario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)

reservas Reserva[]

createdAt DateTime @default(now())



@@map("veiculos")

}



model Vaga {

id String @id @default(uuid())

numero Int @unique

tipo TipoVaga @default(COBERTA)

status StatusVaga @default(LIVRE)

proprietarioId String?

proprietario Usuario? @relation("VagaProprietario", fields: [proprietarioId], references: [id])

reservas Reserva[]

compartilhados Compartilhamento[]



@@map("vagas")

}



model Compartilhamento {

id String @id @default(uuid())

vagaId String

vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)

proprietarioId String

proprietario Usuario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)

dataInicio DateTime

dataFim DateTime

status StatusCompartilhamento @default(ATIVO)



@@map("compartilhamentos")

}



model Reserva {

id String @id @default(uuid())

vagaId String

vaga Vaga @relation(fields: [vagaId], references: [id], onDelete: Cascade)

moradorId String

morador Usuario @relation(fields: [moradorId], references: [id], onDelete: Cascade)

veiculoId String

veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

dataInicio DateTime

dataFim DateTime

status StatusReserva @default(CONFIRMADA)

createdAt DateTime @default(now())



@@map("reservas")

} 